# Optional. Copy to .env locally and supply one provider. Never commit secrets.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# OpenAI-compatible base URL, including /v1 when required by the provider.
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
# Local development: use an already installed Ollama model through the local server.
OLLAMA_MODEL=

# Optional worldwide patent search; approved Lens API access required.
LENS_API_TOKEN=

# Optional host-configured Anthropic and DeepSeek services.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
